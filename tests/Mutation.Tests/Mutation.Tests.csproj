<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- テスト名は仕様を表す snake_case の一文にするため識別子の下線警告を外す -->
